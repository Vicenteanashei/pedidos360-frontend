FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_ENTRA_TENANT_ID
ARG VITE_SPA_CLIENT_ID
ARG VITE_API_CLIENT_ID
ARG VITE_API_BASE_URL
ARG VITE_DIAGNOSTICS=false
ENV VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID VITE_SPA_CLIENT_ID=$VITE_SPA_CLIENT_ID VITE_API_CLIENT_ID=$VITE_API_CLIENT_ID VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_DIAGNOSTICS=$VITE_DIAGNOSTICS
RUN npm run build
FROM nginx:1.28-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
